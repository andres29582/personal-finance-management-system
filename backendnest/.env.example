NODE_ENV=development
PORT=3000

# Development/test podem usar os defaults locais.
# Ambientes expostos exigem origens HTTPS explicitas; wildcard nao e aceito.
# Chamadas de aplicativo nativo e server-to-server sem Origin continuam suportadas.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Limite global para JSON e URL-encoded: 100 KiB. Excedentes retornam HTTP 413.
HTTP_BODY_LIMIT_BYTES=102400

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=gestao_financeira

# Local/test: disable. Ambientes expostos: verify-full obrigatorio.
DB_SSL_MODE=disable

# CA PEM customizada codificada em Base64. Opcional quando a CA publica
# ja e reconhecida pelo trust store do sistema. Nunca versione certificados reais.
DB_SSL_CA_BASE64=
# Nunca use estas credenciais de exemplo em ambientes expostos.

# Legado: fallback permitido somente em development/test.
JWT_SECRET=

# Obrigatorios e distintos em production/demo. Use valores aleatorios com 32+ caracteres.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=5000

# Obrigatoria fora de development/test. Deve coincidir com o servico ML.
ML_INTERNAL_API_KEY=

# Recuperacao de senha: auxiliar local permitido apenas em NODE_ENV=development/test.
# Em production/demo/staging, AUTH_RETURN_RESET_TOKEN=true impede a inicializacao.
AUTH_RETURN_RESET_TOKEN=false
PASSWORD_RESET_TTL_MINUTES=60

# Banco usado pelos testes E2E locais. O nome deve conter "test".
E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_USERNAME=postgres
E2E_DB_PASSWORD=postgres
E2E_DB_NAME=gestao_financeira_test
E2E_DB_ADMIN_DATABASE=postgres
DB_TEST_NAME=gestao_financeira_test
