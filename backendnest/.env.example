NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=gestao_financeira
JWT_SECRET=troque_esta_chave_em_desenvolvimento
JWT_ACCESS_SECRET=troque_esta_chave_de_acesso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque_esta_chave_de_refresh
JWT_REFRESH_EXPIRES_IN=30d
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=5000

# Recuperacao de senha: em desenvolvimento pode devolver resetToken no JSON do forgot-password.
AUTH_RETURN_RESET_TOKEN=false
PASSWORD_RESET_TTL_MINUTES=60

# Banco usado pelos testes E2E locais. O nome deve conter "test".
E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_USERNAME=postgres
E2E_DB_PASSWORD=postgres
E2E_DB_NAME=gestao_financeira_test
E2E_DB_ADMIN_DATABASE=postgres
DB_TEST_NAME=gestao_financeira_test
