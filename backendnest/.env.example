NODE_ENV=development
# ML client environment; falls back to NODE_ENV when omitted.
ML_ENV=development
PORT=3000

# Development/test podem usar os defaults locais.
# Ambientes expostos exigem origens HTTPS explicitas; wildcard nao e aceito.
# Chamadas de aplicativo nativo e server-to-server sem Origin continuam suportadas.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Limite global para JSON e URL-encoded: 100 KiB. Excedentes retornam HTTP 413.
HTTP_BODY_LIMIT_BYTES=102400

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=gestao_financeira

# Local/test: disable. Ambientes expostos: verify-full obrigatorio.
DB_SSL_MODE=disable

# CA PEM customizada codificada em Base64. Opcional quando a CA publica
# ja e reconhecida pelo trust store do sistema. Nunca versione certificados reais.
DB_SSL_CA_BASE64=
# Nunca use estas credenciais de exemplo em ambientes expostos.

# Legado: fallback permitido somente em development/test.
JWT_SECRET=

# Obrigatorios e distintos em production/demo. Use valores aleatorios com 32+ caracteres.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
# Tokens are always HS256 and must match this issuer during verification.
JWT_ISSUER=meu-sistema-financeiro
# Oldest active sessions are revoked on login once this limit is reached.
AUTH_MAX_ACTIVE_SESSIONS=5
ML_API_URL=http://127.0.0.1:8000
ML_API_TIMEOUT_MS=5000

# Obrigatoria fora de ML_ENV=development/test. Use exatamente o mesmo valor
# em ML_INTERNAL_API_KEY no backend e no servico ML; nunca registre essa chave.
ML_INTERNAL_API_KEY=

# Recuperacao de senha: entrega HTTP obrigatoria fora de development/test.
# O endpoint HTTPS recebe email, resetToken e expiresAt; mantenha essa integracao fora dos logs.
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_API_KEY=
# Auxiliar local permitido apenas em NODE_ENV=development/test.
# Em production/demo/staging, AUTH_RETURN_RESET_TOKEN=true impede a inicializacao.
AUTH_RETURN_RESET_TOKEN=false
PASSWORD_RESET_TTL_MINUTES=60

# Perfil E2E separado: nao cria banco/role nem autoriza reset do banco da aplicacao.
# Exige owner restrito, sem memberships, dono somente deste DB e marker
# finance-e2e-disposable. Injete a senha privada antes de executar testes.
E2E_DB_HOST=127.0.0.1
E2E_DB_PORT=55434
E2E_DB_USERNAME=finance_e2e_local_owner
E2E_DB_PASSWORD=
E2E_DB_NAME=finance_e2e_local
E2E_DB_RESET_CONFIRM=finance_e2e_local

# Password-change notification: development simulation only. Never use a real key here.
PASSWORD_CHANGED_WORKER_ENABLED=false
PASSWORD_CHANGED_RESEND_LIVE_ENABLED=false
PASSWORD_CHANGED_SENDER=onboarding@resend.dev
# RESEND_API_KEY is intentionally not consumed by this development runtime.
