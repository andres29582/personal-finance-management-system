# Perfil exposto, inclusive staging publico. INCOMPLETO: nao e credencial pronta.
# Injete segredos/configuracoes por canal privado. Nao carregado por u6:check.
# Regras JWT estritas atuais usam production/demo; staging sozinho nao basta.
NODE_ENV=production
ML_ENV=production
PORT=3000
CORS_ORIGINS=
HTTP_BODY_LIMIT_BYTES=102400
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL_MODE=verify-full
DB_SSL_CA_BASE64=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=meu-sistema-financeiro
AUTH_MAX_ACTIVE_SESSIONS=5
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
ML_API_URL=
ML_INTERNAL_API_KEY=
PASSWORD_RESET_DELIVERY_URL=
PASSWORD_RESET_DELIVERY_API_KEY=
AUTH_RETURN_RESET_TOKEN=false
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_CHANGED_WORKER_ENABLED=false
PASSWORD_CHANGED_RESEND_LIVE_ENABLED=false
# HTTPS real, proxy/topologia, schema, backup e trafego exigem validacao do destino.
